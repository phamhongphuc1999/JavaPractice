Table supplier {
  id int [pk, unique, not null]
  name varchar(50)
  address varchar(100)
  phone varchar(20)
  email varchar(100)
  more_infor varchar(200)
  contract_date datetime
}

Table customer {
  id int [pk, unique, not null]
  name varchar(50)
  address varchar(100)
  phone varchar(20)
  email varchar(100)
  more_infor varchar(200)
  contract_date datetime
}

Table product {
  id binary(16) [pk, unique, not null]
  name varchar(50)
  supplier_id int [not null, ref: > supplier.id]
  quantity int
  created_at datetime
  update_at datetime
}

Table payment_method {
  id int [pk, unique, not null]
  name varchar(50) [not null]
}

Table order {
  id int [pk, unique, not null]
  customer_id int [not null, ref: > customer.id]
  order_date datetime
  status varchar(10) [not null]
  total_amount int [not null]
  payment_method_id int [not null, ref: > payment_method.id]
  shipping_address varchar(50) [not null]
  created_at datetime
  updated_at datetime
}

Table order_detail {
  id int [pk, unique, not null]
  order_id int [not null, ref: > order.id]
  product_id int [not null, ref: < product.id]
  quantity int [not null]
  price decimal
}

Table import_product {
  id int [pk, unique, not null]
  input_date datetime
}

Table import_product_detail {
  id int [pk, unique, not null]
  product_id int [not null, ref: > product.id]
  import_id int [not null, ref: - import_product.id]
  quantity int
}
